# ============================================================
# compose-or-collide .gitignore
# ============================================================

# --- Secrets and credentials ---
.env
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
*.egg-info/
dist/
build/
.eggs/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Model weights and checkpoints ---
# These are large binary files — download from HuggingFace at runtime
*.bin
*.safetensors

# Avoid large vectors besides the extracted behavioral
*.pt
!results/vectors/*.pt

*.pth
*.ckpt
checkpoints/
models/

# --- Activation cache ---
# Extracted activations can be hundreds of GB — never commit
activations/
*.pkl
*.npy
*.npz

# --- Results and outputs ---
# Commit only final figures and tables, not raw result dumps
results/raw/

# --- Experiment logs ---
wandb/
runs/
logs/
*.log
mlruns/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- Temporary files ---
tmp/
temp/
scratch/